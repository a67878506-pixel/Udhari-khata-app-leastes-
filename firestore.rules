rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Unique Username Registry (publicly readable for availability check, write strictly authenticated)
    match /user_ids/{customUserId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.uid == request.resource.data.uid
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/user_ids/$(customUserId));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Helper functions
    function isKhataMember(khataId) {
      return request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/khatas/$(khataId)).data.memberUids ||
        request.auth.uid == get(/databases/$(database)/documents/khatas/$(khataId)).data.ownerUid
      );
    }

    // Khatas Collection
    match /khatas/{khataId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.ownerUid
      );
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids;
      
      // Update rules:
      // 1. Existing members or owner can update.
      // 2. Soft-delete and Recover can ONLY be performed by the owner.
      // 3. A partner leaving can remove only their own UID.
      // 4. A non-member recipient can update ONLY to accept a pending share request.
      allow update: if request.auth != null && (
        // Case 1: Owner updating khata details
        request.auth.uid == resource.data.ownerUid ||

        // Case 2: Regular member updating khata balances/metadata (cannot change ownerUid, memberUids, or isDeleted)
        (
          request.auth.uid in resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.isDeleted == resource.data.isDeleted
        ) ||
        
        // Case 3: Partner leaving the khata voluntarily (removes ONLY their own UID)
        (
          request.auth.uid in resource.data.memberUids &&
          request.auth.uid != resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.isDeleted == resource.data.isDeleted &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids.removeAll([request.auth.uid])) &&
          request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
          !(request.auth.uid in request.resource.data.memberUids)
        ) ||

        // Case 3: Recipient accepting a share request
        (
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.totalPeople == resource.data.totalPeople &&
          request.resource.data.totalLena == resource.data.totalLena &&
          request.resource.data.totalDena == resource.data.totalDena &&
          request.resource.data.netBalance == resource.data.netBalance &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
          request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid])) &&
          request.auth.uid in request.resource.data.memberUids &&
          !(request.auth.uid in resource.data.memberUids)
        )
      );
      
      // Permanent delete allowed strictly by the owner
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // Subcollections inside Khata
      match /people/{personId} {
        allow read: if isKhataMember(khataId);
        allow write: if isKhataMember(khataId);
        allow delete: if request.auth != null && (
          isKhataMember(khataId) || 
          request.auth.uid == get(/databases/$(database)/documents/khatas/$(khataId)).data.ownerUid
        );
      }

      match /transactions/{transactionId} {
        allow read: if isKhataMember(khataId);
        allow write: if isKhataMember(khataId);
        allow delete: if request.auth != null && (
          isKhataMember(khataId) || 
          request.auth.uid == get(/databases/$(database)/documents/khatas/$(khataId)).data.ownerUid
        );
      }

      match /history/{historyId} {
        allow read: if isKhataMember(khataId);
        allow create: if request.auth != null && (
          isKhataMember(khataId) ||
          request.auth.uid in get(/databases/$(database)/documents/khatas/$(khataId)).data.memberUids ||
          request.resource.data.performedByUid == request.auth.uid
        );
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/khatas/$(khataId)).data.ownerUid;
      }
    }

    // Share Requests
    match /shareRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      
      // Update rules:
      // - Immutable fields (fromUid, toUid, khataId) cannot be altered.
      // - Recipient (toUid) can change status from PENDING to ACCEPTED or REJECTED.
      // - Sender (fromUid) can change status from PENDING to CANCELLED.
      allow update: if request.auth != null 
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.khataId == resource.data.khataId
        && (
          (request.auth.uid == resource.data.toUid && resource.data.status == 'PENDING' && (request.resource.data.status == 'ACCEPTED' || request.resource.data.status == 'REJECTED')) ||
          (request.auth.uid == resource.data.fromUid && resource.data.status == 'PENDING' && request.resource.data.status == 'CANCELLED')
        );
        
      allow delete: if request.auth != null && request.auth.uid == resource.data.fromUid;
    }
  }
}
